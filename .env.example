# Copy this file to .env.local (local) or set these as environment variables
# in your host (e.g. Vercel) for production.

# --- Database (Supabase / PostgreSQL) ---
# From the Supabase dashboard → Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ---
# A long random string used to sign login tokens. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Google Gemini AI (optional) ---
# Without a key the app uses smart built-in suggestions.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Web Push notifications (optional) ---
# Generate a key pair: node scripts/gen-vapid.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Secret guarding /api/push/run (use the same value in your cron job).
CRON_SECRET=

# --- Cookies ---
# true on HTTPS (production, e.g. Vercel); false for local http.
COOKIE_SECURE=false

# --- App ---
APP_URL=http://localhost:3000
